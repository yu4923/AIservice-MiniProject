# Public browser settings only. Never put secrets in VITE_* variables.
VITE_RAG_API_URL=http://localhost:8001
VITE_INTERNAL_RAG_API_URL=http://localhost:8002

# 실제 Spring Boot 쿠키 인증 사용. 화면 체험만 할 때 true로 변경
VITE_DEMO_MODE=false
VITE_AUTH_API_URL=http://localhost:8080
VITE_LOGIN_PATH=/api/login
VITE_SIGNUP_PATH=/api/signup
VITE_LOGOUT_PATH=/api/logout
VITE_AUTH_CHECK_PATH=/api/auth/check
VITE_RAG_PATH=/rag-query
VITE_RAG_QUESTION_FIELD=question

# 추천 API는 로그인/대화 데모 모드와 별개로 실제 서버에 요청합니다.
VITE_RECOMMEND_API_URL=http://localhost:8002
