# Copy to .env and fill locally. Existing process environment has precedence.
JWT_SECRET=''
FRONTEND_ORIGIN=http://localhost:5174
OPENAI_API_KEY=''
LLM_MODEL=gpt-4o
YOUTH_POLICY_API_KEY=''
RAG_EMBEDDING_MODEL=nlpai-lab/KURE-v1
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=8
# RAG_FAISS_DIR=/absolute/path/to/data/faiss-kure-v1
# RAG_PREPROCESS_DIR=/absolute/path/to/preprocessed
RAG_BUILD_ON_START=true
# web, pdf, or web,pdf. Missing required indexes are built before serving.
RAG_REQUIRED_INDEXES=web
NAVER_CLIENT_ID=''
NAVER_CLIENT_SECRET=''

# LangSmith tracing (enable with your own key)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=youth-compass
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Hide question/profile and response bodies by default.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
