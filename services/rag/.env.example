# Copy to .env and fill in values. Never commit .env.
# Local embeddings: no OpenAI API key required for RAG ingestion/search.
RAG_EMBEDDING_MODEL=nlpai-lab/KURE-v1
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=8
# Default index: <project>/data/faiss-kure-v1. Set an absolute path to override.
# RAG_FAISS_DIR=/absolute/path/to/data/faiss-kure-v1
# URL-encode special characters in username/password.
# Format: mysql+aiomysql://USER:PASSWORD@127.0.0.1:53301/sql_db?charset=utf8mb4
ASYNC_DB_URL=''
# Required when using Naver web search.
NAVER_CLIENT_ID=''
NAVER_CLIENT_SECRET=''
