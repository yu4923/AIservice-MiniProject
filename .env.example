# Root Compose settings. Copy to .env locally; never commit real secrets.
# All Compose commands parse DB/JWT variables, including the ingestion command.
DB_USER=appuser
DB_PASSWORD=
MARIADB_ROOT_PASSWORD=
JWT_SECRET=

# Required for actual LLM recommendations; not needed for PDF embeddings.
OPENAI_API_KEY=
# Optional policy supplementation.
YOUTH_POLICY_API_KEY=
LLM_MODEL=gpt-4o

RAG_EMBEDDING_MODEL=nlpai-lab/KURE-v1
RAG_EMBEDDING_BATCH_SIZE=8
# Optional: only for Naver keyword-based web ingestion.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Local ports; SEARCH_PORT is the unified FastAPI port.
# This draft exposes them on 127.0.0.1 only.
FRONTEND_PORT=5174
AUTH_PORT=8080
SEARCH_PORT=8002
# Match the URL used in the browser. If FRONTEND_PORT changes, update both URLs too.
FRONTEND_ORIGIN=http://localhost:5174
LOGIN_SUCCESS_URL=http://localhost:5174
